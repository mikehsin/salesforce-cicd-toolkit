# Copy this to .env for local use — never commit the real .env file.
# In CI, these are set as GitHub Actions Secrets instead (see README).

# Salesforce DX auth URLs (sf org display --verbose --json to obtain)
SF_AUTH_URL=force://...
SF_AUTH_URL_DEV=force://...
SF_AUTH_URL_PROD=force://...

# AI provider for scripts/ai_fix.py — any OpenAI-compatible chat completions API
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-8b-instruct
